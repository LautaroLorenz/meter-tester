# Config del Vault Kit para meter-tester. A diferencia de ~/.claude/vault-kit.env
# (que apunta al vault de compliance), esta viaja con el repo: las rutas se
# resuelven relativas a este archivo, asi sirve en cualquier maquina.
# La lee .claude/sync-vault-rules.sh via VAULT_KIT_CONFIG (ver .claude/settings.json).

VAULT_KIT_WORKSPACE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VAULT_KIT_VAULT="$VAULT_KIT_WORKSPACE/vault"

# Carpetas del vault por ROL. Vacia = rol apagado.
VAULT_DIR_RULES="reglas"
VAULT_DIR_SOLUTIONS="soluciones"
VAULT_DIR_RECIPES="recetas"
VAULT_DIR_ADRS="adr"
VAULT_DIR_QUERIES=""
VAULT_DIR_REVIEWS=""
VAULT_DIR_TICKETS=""
VAULT_DIR_QA=""
VAULT_DIR_REPOS=""
VAULT_DIR_TEMPLATES=""
